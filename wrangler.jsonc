// Cloudflare Workers config — SvelteKit frontend (Workers Builds service "mailpal")
// Build: npm run check && npm run build (vite) → output .svelte-kit/cloudflare →
// deployed by Workers Builds from main only
// KV shared with email-worker (same namespace: domains/aliases/settings state)
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailpal",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Builds deploys this worker from main; a version uploaded from any
	// other ref would run against the production KV and secrets, so it gets no
	// public preview URL. Every deploy applies this setting.
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "a5b47fc2480a46dc9f1b3aff7972c1d1"
		}
	]
}
